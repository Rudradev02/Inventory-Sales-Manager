modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

deployment.postBuild.args = ["pnpm", "store", "prune"]
deployment.postBuild.env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Inventory Sales Manager"

[[workflows.workflow]]
name = "Inventory Sales Manager"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd inventory_sales_manager && python manage.py runserver 0.0.0.0:8000"
waitForPort = 8000

[workflows.workflow.metadata]
outputType = "webview"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000
